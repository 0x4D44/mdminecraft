# Headless exploratory QA script (run with mdm_harness_client.py --auto-id)

{"op":"get_state"}
{"op":"command","line":"/gamemode creative"}
{"op":"command","line":"/time set day"}
{"op":"command","line":"/weather clear"}
{"op":"step","ticks":5}
{"op":"screenshot","tag":"spawn_day"}

# S1: sky/day-night snapshots from a high vantage
{"op":"command","line":"/tp 0 130 0"}
{"op":"command","line":"/time set day"}
{"op":"set_view","yaw":0.30,"pitch":0.25}
{"op":"step","ticks":5}
{"op":"screenshot","tag":"sky_day"}
{"op":"command","line":"/time set noon"}
{"op":"set_view","yaw":1.5707964,"pitch":1.20}
{"op":"step","ticks":5}
{"op":"screenshot","tag":"sky_noon"}
{"op":"command","line":"/time set night"}
{"op":"set_view","yaw":-0.30,"pitch":0.25}
{"op":"step","ticks":5}
{"op":"screenshot","tag":"sky_night"}
{"op":"command","line":"/time set midnight"}
{"op":"set_view","yaw":-1.5707964,"pitch":1.20}
{"op":"step","ticks":5}
{"op":"screenshot","tag":"sky_midnight"}

# S2: weather states
{"op":"command","line":"/time set day"}
{"op":"step","ticks":5}
{"op":"command","line":"/weather clear"}
{"op":"step","ticks":20}
{"op":"screenshot","tag":"weather_clear"}
{"op":"command","line":"/weather rain"}
{"op":"step","ticks":40}
{"op":"screenshot","tag":"weather_rain"}
{"op":"command","line":"/weather thunder"}
{"op":"step","ticks":40}
{"op":"screenshot","tag":"weather_thunder"}
{"op":"command","line":"/weather clear"}
{"op":"step","ticks":20}

# S3: block palette (build + day/night)
{"op":"command","line":"/tp 0 110 0"}
{"op":"command","line":"/fill -12 99 -12 12 99 12 stone"}
{"op":"command","line":"/fill -12 100 -12 12 105 12 air"}

{"op":"command","line":"/setblock -10 100 -10 stone"}
{"op":"command","line":"/setblock -8 100 -10 dirt"}
{"op":"command","line":"/setblock -6 100 -10 grass"}
{"op":"command","line":"/setblock -4 100 -10 sand"}
{"op":"command","line":"/setblock -2 100 -10 gravel"}
{"op":"command","line":"/setblock 0 100 -10 cobblestone"}

{"op":"command","line":"/setblock -10 100 -8 oak_planks"}
{"op":"command","line":"/setblock -8 100 -8 oak_log"}
{"op":"command","line":"/setblock -6 100 -8 oak_leaves"}
{"op":"command","line":"/setblock -4 100 -8 glass"}
{"op":"command","line":"/setblock -2 100 -8 torch"}
{"op":"command","line":"/setblock 0 100 -8 glowstone"}

{"op":"command","line":"/setblock -10 100 -6 stone_slab"}
{"op":"command","line":"/setblock -8 100 -6 oak_slab"}
{"op":"command","line":"/setblock -6 100 -6 stone_stairs"}
{"op":"command","line":"/setblock -4 100 -6 oak_stairs"}
{"op":"command","line":"/setblock -2 100 -6 stone_bricks"}
{"op":"command","line":"/setblock 0 100 -6 stone_brick_wall"}

{"op":"command","line":"/setblock -10 100 -4 ice"}
{"op":"command","line":"/setblock -8 100 -4 snow"}
{"op":"command","line":"/setblock -6 100 -4 clay"}
{"op":"command","line":"/setblock -4 100 -4 bedrock"}

{"op":"step","ticks":60}
{"op":"command","line":"/time set day"}
{"op":"command","line":"/tp -6 120 -6"}
{"op":"set_view","yaw":0.0,"pitch":-1.2}
{"op":"step","ticks":5}
{"op":"screenshot","tag":"palette_day"}
{"op":"command","line":"/time set night"}
{"op":"step","ticks":5}
{"op":"screenshot","tag":"palette_night"}

# S4: chunk seam structure (cross x=16 boundary)
{"op":"command","line":"/time set midnight"}
{"op":"command","line":"/fill 8 99 -8 24 99 8 stone_bricks"}
{"op":"command","line":"/fill 15 100 -2 17 104 2 stone_bricks"}
{"op":"command","line":"/setblock 15 102 0 glowstone"}
{"op":"command","line":"/setblock 16 102 0 glowstone"}
{"op":"command","line":"/setblock 17 102 0 glowstone"}
{"op":"step","ticks":60}
{"op":"command","line":"/tp 16 108 -14"}
{"op":"set_view","yaw":1.5707964,"pitch":-0.35}
{"op":"step","ticks":5}
{"op":"screenshot","tag":"seam_structure"}
{"op":"screenshot","tag":"seam_lighting"}

# S5: fluids
{"op":"command","line":"/time set day"}
{"op":"command","line":"/fill -12 99 12 12 99 36 stone"}
{"op":"command","line":"/fill -12 100 12 12 110 36 air"}
{"op":"command","line":"/fill -12 100 12 12 102 12 stone"}
{"op":"command","line":"/fill -12 100 36 12 102 36 stone"}
{"op":"command","line":"/fill -12 100 12 -12 102 36 stone"}
{"op":"command","line":"/fill 12 100 12 12 102 36 stone"}
{"op":"command","line":"/fill -11 100 13 11 100 35 water"}
{"op":"step","ticks":120}
{"op":"command","line":"/tp 0 108 8"}
{"op":"set_view","yaw":1.5707964,"pitch":-0.45}
{"op":"step","ticks":5}
{"op":"screenshot","tag":"water_pool"}
{"op":"command","line":"/tp 0 100 24"}
{"op":"set_view","yaw":1.5707964,"pitch":0.0}
{"op":"step","ticks":5}
{"op":"screenshot","tag":"water_underwater"}

{"op":"command","line":"/fill 30 99 -4 50 99 4 stone"}
{"op":"command","line":"/fill 30 100 -4 50 140 4 air"}
{"op":"command","line":"/fill 37 129 -1 43 129 1 stone"}
{"op":"command","line":"/setblock 40 129 0 air"}
{"op":"command","line":"/fill 40 100 0 40 128 0 air"}
{"op":"command","line":"/setblock 40 130 0 water"}
{"op":"step","ticks":200}
{"op":"command","line":"/tp 40 120 12"}
{"op":"set_view","yaw":-1.5707964,"pitch":-0.35}
{"op":"step","ticks":5}
{"op":"screenshot","tag":"waterfall"}

# S6: mobs / animals
{"op":"command","line":"/fill -12 99 36 12 99 60 stone"}
{"op":"command","line":"/fill -12 100 36 12 110 60 air"}
{"op":"command","line":"/time set day"}
{"op":"command","line":"/tp 0 101 48"}
{"op":"command","line":"/summon pig ~-4 ~ ~4"}
{"op":"command","line":"/summon cow ~-2 ~ ~4"}
{"op":"command","line":"/summon sheep ~ ~ ~4"}
{"op":"command","line":"/summon chicken ~2 ~ ~4"}
{"op":"command","line":"/summon villager ~4 ~ ~4"}
{"op":"set_view","yaw":1.5707964,"pitch":-0.25}
{"op":"step","ticks":60}
{"op":"screenshot","tag":"mobs_passive"}

{"op":"command","line":"/tp 0 101 56"}
{"op":"command","line":"/summon zombie ~-4 ~ ~4"}
{"op":"command","line":"/summon skeleton ~-2 ~ ~4"}
{"op":"command","line":"/summon spider ~ ~ ~4"}
{"op":"command","line":"/summon creeper ~2 ~ ~4"}
{"op":"set_view","yaw":1.5707964,"pitch":-0.25}
{"op":"step","ticks":60}
{"op":"screenshot","tag":"mobs_hostile"}

# S7: movement smoke (headless action injection)
{"op":"command","line":"/tp 0 101 0"}
{"op":"command","line":"/time set day"}
{"op":"set_view","yaw":0.0,"pitch":-0.25}
{"op":"set_actions","actions":{"move_y":1.0,"sprint":true}}
{"op":"step","ticks":40}
{"op":"screenshot","tag":"move_smoke_1"}
{"op":"step","ticks":40}
{"op":"screenshot","tag":"move_smoke_2"}
{"op":"set_actions","actions":{"move_y":0.0,"sprint":false}}

{"op":"shutdown"}
